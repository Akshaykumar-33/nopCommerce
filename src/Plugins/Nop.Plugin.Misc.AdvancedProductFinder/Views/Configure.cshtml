@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

@await Component.InvokeAsync(typeof(Nop.Web.Areas.Admin.Components.StoreScopeConfigurationViewComponent))

<form asp-controller="AdvancedProductFinderAdmin" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="Enabled_OverrideForStore" asp-input="Enabled" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="Enabled" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="Enabled" />
                                <span asp-validation-for="Enabled"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="ShowHomepageWidget_OverrideForStore" asp-input="ShowHomepageWidget" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="ShowHomepageWidget" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="ShowHomepageWidget" />
                                <span asp-validation-for="ShowHomepageWidget"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="ShowRecentlyViewed_OverrideForStore" asp-input="ShowRecentlyViewed" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="ShowRecentlyViewed" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="ShowRecentlyViewed" />
                                <span asp-validation-for="ShowRecentlyViewed"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="ShowCompleteTheSet_OverrideForStore" asp-input="ShowCompleteTheSet" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="ShowCompleteTheSet" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="ShowCompleteTheSet" />
                                <span asp-validation-for="ShowCompleteTheSet"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="ProductsPerPage_OverrideForStore" asp-input="ProductsPerPage" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="ProductsPerPage" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="ProductsPerPage" />
                                <span asp-validation-for="ProductsPerPage"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="CompleteTheSetNumber_OverrideForStore" asp-input="CompleteTheSetNumber" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="CompleteTheSetNumber" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="CompleteTheSetNumber" />
                                <span asp-validation-for="CompleteTheSetNumber"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="WidgetZone_OverrideForStore" asp-input="WidgetZone" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="WidgetZone" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="WidgetZone" />
                                <span asp-validation-for="WidgetZone"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-9 offset-md-3">
                                <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
